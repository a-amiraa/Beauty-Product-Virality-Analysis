    "# Safety loader: ensure merged_df exists so visualization cells can run standalone\n",
    "import pandas as pd\n",
    "from pathlib import Path\n",
    "def ensure_merged_df():\n",
    "    base = Path('/Users/amy/Desktop/Data_Projects/product virality analysis')\n",
    "    product_df = pd.read_csv(base / 'data' / 'product_info.csv')\n",
    "    marketing_df = pd.read_csv(base / 'data' / 'marketing_info.csv', header=1)\n",
    "    product_df = product_df.loc[:, ~product_df.columns.str.startswith('Unnamed')]\n",
    "    product_df = product_df.dropna(how='all').reset_index(drop=True)\n",
    "    product_df.columns = product_df.columns.str.strip()\n",
    "    marketing_df.columns = marketing_df.columns.str.strip()\n",
    "    product_df['product_name'] = product_df['product_name'].str.strip()\n",
    "    marketing_df['product_name'] = marketing_df['product_name'].str.strip()\n",
    "    product_df['price'] = pd.to_numeric(product_df['price'].astype(str).str.replace('£','', regex=False))\n",
    "    product_df['estimated_viral_date'] = product_df['estimated_viral_date'].astype(int)\n",
    "    merged_df = pd.merge(product_df, marketing_df, on='product_name', how='inner', validate='one_to_one')\n",
    "    merged_df['timing_group'] = (merged_df['viral_delay']>0).map({True:'Cross-year delayed virality', False:'Same-year virality'})\n",
    "    return merged_df\n",
    "# If merged_df is missing (kernel restart or cells run out of order), create it\n",
    "if 'merged_df' not in globals():\n",
    "    merged_df = ensure_merged_df()\n"
   ]
  },
