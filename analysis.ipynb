  {
   "cell_type": "markdown",
   "id": "8bd39e16",
   "metadata": {},
   "source": [
    "## Visualisations"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 64,
   "id": "0dcb98fa",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-12T10:15:27.884300Z",
     "iopub.status.busy": "2026-10-12T10:15:27.884231Z",
     "iopub.status.idle": "2026-10-12T10:15:28.400924Z",
     "shell.execute_reply": "2026-10-12T10:15:28.400264Z"
    }
   },
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1000x600 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# =============================================================================\n",
    "# Visualisation 1: Estimated Viral Delay by Product\n",
    "# =============================================================================\n",
    "\n",
    "import matplotlib.pyplot as plt  \n",
    "import numpy as np  \n",
    "from pathlib import Path  \n",
    "\n",
    "\n",
    "COLOR_SAME_YEAR = \"#F2D0D5\" \n",
    "COLOR_CROSS_YEAR = \"#6B4E71\"  \n",
    "\n",
    "\n",
    "output_dir = Path(\"visualisations\") \n",
    "output_dir.mkdir(exist_ok=True)  \n",
    "\n",
    "\n",
    "# Rebuild any stale delay values before charting so the graph reflects the source data\n",
    "if 'merged_df' in globals():\n",
    "    merged_df['launch_year'] = merged_df['launch_date'].astype(str).str.extract(r'(\\d{4})', expand=False).astype(float).fillna(0).astype(int)\n",
    "    merged_df['estimated_viral_year'] = merged_df['estimated_viral_date'].astype(str).str.extract(r'(\\d{4})', expand=False).astype(float).fillna(0).astype(int)\n",
    "    merged_df['viral_delay'] = (merged_df['estimated_viral_year'] - merged_df['launch_year']).fillna(0).astype(int)\n",
    "    merged_df['timing_group'] = (merged_df['viral_delay'] > 0).map({True: 'Cross-year delayed virality', False: 'Same-year virality'})\n",
    "\n",
    "delay_df = merged_df.sort_values(\"viral_delay\", ascending=True).copy()  \n",
    "\n",
    "\n",
    "bar_colors = delay_df[\"timing_group\"].map(  \n",
    "    {\n",
    "        \"Same-year virality\": COLOR_SAME_YEAR,  \n",
    "        \"Cross-year delayed virality\": COLOR_CROSS_YEAR, \n",
    "    }\n",
    ")  \n",
    "\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(10, 6), facecolor=\"white\")  \n",
    "ax.set_facecolor(\"white\")  \n",
    "\n",
    "\n",
    "bars = ax.barh(  \n",
    "    delay_df[\"product_name\"],  \n",
    "    delay_df[\"viral_delay\"],  \n",
    "    color=bar_colors,  \n",
    "    edgecolor=\"none\",  \n",
    ")  \n",
    "\n",
    "for bar, delay in zip(bars, delay_df[\"viral_delay\"]):  \n",
    "    if pd.isna(delay):\n",
    "        delay_label = \"0\"\n",
    "    else:\n",
    "        delay_num = float(delay)\n",
    "        delay_label = str(int(delay_num)) if delay_num.is_integer() else f\"{delay_num:.1f}\"\n",
    "    ax.text(  \n",
    "        bar.get_width() + 0.05,  \n",
    "        bar.get_y() + bar.get_height() / 2,  \n",
    "        delay_label,  \n",
    "        va=\"center\",  \n",
    "        ha=\"left\",  \n",
    "        fontsize=10,  \n",
    "        color=\"#4A4A4A\",  \n",
    "    )  \n",
    "\n",
    "\n",
    "ax.set_title(\"Estimated Viral Delay by Product\", fontsize=14, fontweight=\"bold\", pad=12) \n",
    "ax.set_xlabel(\"Estimated viral delay (years)\", fontsize=11)  \n",
    "ax.set_ylabel(\"Product\", fontsize=11)  \n",
    "\n",
    "\n",
    "max_delay = int(np.ceil(delay_df[\"viral_delay\"].max()))  \n",
    "ax.set_xticks(range(0, max_delay + 1))  \n",
    "ax.set_xlim(0, max_delay + 0.8)  \n",
    "\n",
    "\n",
    "ax.spines[\"top\"].set_visible(False)  \n",
