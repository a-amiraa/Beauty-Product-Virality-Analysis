    "# =============================================================================\n",
    "# Visualisation 3: Product Prices by Virality Timing Group\n",
    "# =============================================================================\n",
    "\n",
    "import matplotlib.pyplot as plt  # Import Matplotlib for plotting\n",
    "import numpy as np  # Import NumPy for jitter and median calculations\n",
    "from pathlib import Path  # Import Path for save location\n",
    "\n",
    "# Define consistent beauty-inspired colours\n",
    "COLOR_SAME_YEAR = \"#F2D0D5\"  # Light muted pink for same-year group dots\n",
    "COLOR_CROSS_YEAR = \"#6B4E71\"  # Dark plum for cross-year group dots\n",
    "COLOR_MAUVE = \"#B899AD\"  # Mauve for median markers\n",
    "\n",
    "# Define the required group order for the x-axis\n",
    "group_order = [\"Same-year virality\", \"Cross-year delayed virality\"]  # Keep groups in this order\n",
    "\n",
    "# Map each timing group to a numeric x position\n",
    "group_positions = {group: index for index, group in enumerate(group_order)}  # Position lookup dictionary\n",
    "\n",
    "# Set a random seed so the jitter is reproducible\n",
    "np.random.seed(42)  # Fix the seed for consistent dot placement\n",
    "\n",
    "# Create the figure and axes with a white background\n",
    "fig, ax = plt.subplots(figsize=(8, 6), facecolor=\"white\")  # Set up the figure\n",
    "ax.set_facecolor(\"white\")  # Ensure the axes background is white\n",
    "\n",
    "# Plot jittered dots and median markers for each timing group\n",
    "for group, color in zip(group_order, [COLOR_SAME_YEAR, COLOR_CROSS_YEAR]):  # Loop through groups and colours\n",
    "    group_prices = merged_df.loc[merged_df[\"timing_group\"] == group, \"price\"]  # Select prices in the group\n",
    "    x_base = group_positions[group]  # Base x position for the group\n",
    "    jitter = np.random.uniform(-0.12, 0.12, size=len(group_prices))  # Generate horizontal jitter offsets\n",
    "    ax.scatter(  # Plot individual product prices as dots\n",
    "        x_base + jitter,  # Apply jitter to spread dots horizontally\n",
    "        group_prices.values,  # Y values: product prices\n",
    "        color=color,  # Use the group colour\n",
    "        s=80,  # Set dot size\n",
    "        alpha=0.85,  # Add slight transparency for overlapping points\n",
    "        edgecolors=\"#FFFFFF\",  # Add a white edge around each dot\n",
    "        linewidths=0.8,  # Set a thin edge width\n",
    "        zorder=3,  # Draw dots above grid lines and spines\n",
    "    )  # End scatter plot\n",
    "\n",
    "    median_price = group_prices.median()  # Calculate the median price for the group\n",
    "    ax.hlines(  # Draw a clearly visible median marker\n",
    "        median_price,  # Y position at the group median\n",
    "        x_base - 0.25,  # Start x position of the median line\n",
    "        x_base + 0.25,  # End x position of the median line\n",
    "        colors=COLOR_MAUVE,  # Use mauve for the median marker\n",
    "        linewidths=3,  # Make the median marker easy to see\n",
    "        zorder=4,  # Draw the median above the dots\n",
    "    )  # End median marker\n",
    "    ax.text(  # Label the median value clearly\n",
    "        x_base + 0.32,  # Place the label just to the right of the marker\n",
    "        median_price,  # Align the label vertically with the median\n",
    "        f\"Median: £{median_price:.2f}\",  # Median label text\n",
    "        va=\"center\",  # Vertically centre the label\n",
    "        ha=\"left\",  # Align the label to the left of its anchor\n",
    "        fontsize=9,  # Keep the label readable but compact\n",
    "        color=\"#4A4A4A\",  # Use neutral dark grey text\n",
    "    )  # End median label\n",
    "\n",
    "# Set x-axis tick positions and group labels\n",
    "ax.set_xticks(range(len(group_order)))  # Place one tick per timing group\n",
    "ax.set_xticklabels(group_order)  # Label ticks with the timing group names\n",
    "\n",
    "# Set the chart title and axis labels\n",
    "ax.set_title(\"Product Prices by Virality Timing Group\", fontsize=14, fontweight=\"bold\", pad=12)  # Chart title\n",
    "ax.set_xlabel(\"Timing group\", fontsize=11)  # X-axis label\n",
    "ax.set_ylabel(\"Price (£)\", fontsize=11)  # Y-axis label\n",
    "\n",
    "# Remove unnecessary borders and add a light y-axis grid\n",
    "ax.spines[\"top\"].set_visible(False)  # Hide the top spine\n",
    "ax.spines[\"right\"].set_visible(False)  # Hide the right spine\n",
    "ax.spines[\"bottom\"].set_color(\"#CCCCCC\")  # Soften the bottom spine\n",
    "ax.spines[\"left\"].set_color(\"#CCCCCC\")  # Soften the left spine\n",
    "ax.yaxis.grid(True, linestyle=\"--\", alpha=0.4, color=\"#CCCCCC\")  # Add subtle horizontal grid lines\n",
    "ax.set_axisbelow(True)  # Draw the grid behind the data points\n",
    "ax.tick_params(colors=\"#4A4A4A\")  # Ensure tick labels are readable\n",
    "\n",
    "# Add the required exploratory note below the chart\n",
    "fig.text(  # Add text at figure level so it sits beneath the plot\n",
    "    0.5,  # Centre the note horizontally\n",
    "    0.02,  # Place the note near the bottom of the figure\n",
    "    \"The chart shows an exploratory difference within 10 selected products and does not establish causation.\",  # Note text\n",
    "    ha=\"center\",  # Centre-align the note\n",
    "    va=\"bottom\",  # Anchor the note from its bottom edge\n",
    "    fontsize=9,  # Use a smaller font for the note\n",
    "    color=\"#666666\",  # Use a muted grey for the note\n",
    "    style=\"italic\",  # Italicise the figure note\n",
    ")  # End figure note\n",
    "\n",
    "# Adjust layout and leave room for the note\n",
    "plt.tight_layout(rect=[0, 0.06, 1, 1])  # Reserve bottom space for the figure note\n",
    "\n",
    "# Save the chart at high resolution\n",
    "output_dir = Path(\"visualisations\")  # Reference the output folder\n",
    "save_path = output_dir / \"price_by_timing_group.png\"  # Define the output file path\n",
    "fig.savefig(save_path, dpi=300, bbox_inches=\"tight\", facecolor=\"white\")  # Save the PNG at 300 DPI\n",
    "\n",
    "# Display the chart in the notebook\n",
    "plt.show()  # Render the figure"
   ]
