    "# =============================================================================\n",
    "# Visualisation 2: Virality Timing Groups (patched safe version)\n",
    "# =============================================================================\n",
    "\n",
    "import matplotlib.pyplot as plt  # Import Matplotlib for plotting\n",
    "from pathlib import Path  # Import Path for save location\n",
    "import pandas as pd\n",
    "import math\n",
    "\n",
    "# Define consistent beauty-inspired colours\n",
    "COLOR_SAME_YEAR = \"#F2D0D5\"  # Light muted pink for same-year virality\n",
    "COLOR_CROSS_YEAR = \"#6B4E71\"  # Dark plum for cross-year delayed virality\n",
    "\n",
    "# Define the required category order for the x-axis\n",
    "category_order = [\"Same-year virality\", \"Cross-year delayed virality\"]  # Keep groups in this order\n",
    "\n",
    "# Count products in each timing group\n",
    "# Force the delay and timing group to be derived from the year values, which avoids stale or missing values in the kernel\n",
    "if 'merged_df' in globals():\n",
    "    merged_df['launch_year'] = merged_df['launch_date'].astype(str).str.extract(r'(\\d{4})', expand=False).astype(float).fillna(0).astype(int)\n",
    "    merged_df['estimated_viral_year'] = merged_df['estimated_viral_date'].astype(str).str.extract(r'(\\d{4})', expand=False).astype(float).fillna(0).astype(int)\n",
    "    merged_df['viral_delay'] = (merged_df['estimated_viral_year'] - merged_df['launch_year']).fillna(0).astype(int)\n",
    "    merged_df['timing_group'] = (merged_df['viral_delay'] > 0).map({True: 'Cross-year delayed virality', False: 'Same-year virality'})\n",
    "\n",
    "# Ordered counts\n",
    "import numpy as np\n",
    "\n",
    "timing_counts = merged_df[\"timing_group\"].value_counts().reindex(category_order)\n",
    "# Replace missing categories with zeros so plotting and formatting don't error\n",
    "timing_counts = timing_counts.fillna(0).astype(int)\n",
    "\n",
    "# Calculate the total number of products and each group's percentage\n",
    "total_products = timing_counts.sum()  # Total products in the selected sample\n",
    "percentages = (timing_counts / total_products * 100).round(1).fillna(0)  # Percentage share for each group\n",
    "\n",
    "# Assign bar colours in the same order as the categories\n",
    "bar_colors = [COLOR_SAME_YEAR, COLOR_CROSS_YEAR]  # Match colours to the two timing groups\n",
    "\n",
    "# Create the figure with space for a figure note\n",
    "fig, ax = plt.subplots(figsize=(8, 6), facecolor=\"white\")  # Set up a white-background figure\n",
    "ax.set_facecolor(\"white\")  # Ensure the axes background is white\n",
    "\n",
    "# Draw vertical bars comparing the timing groups\n",
    "bars = ax.bar(  # Create vertical bars\n",
    "    category_order,  # X-axis categories in the required order\n",
    "    timing_counts.values,  # Y-axis values: number of products\n",
    "    color=bar_colors,  # Apply the group colours\n",
    "    width=0.55,  # Set a moderate bar width\n",
    "    edgecolor=\"none\",  # Remove bar edge lines\n",
    ")  # End vertical bar chart\n",
    "\n",
    "# Add the count and percentage above each bar (defensive)\n",
    "_pct_labels = []\n",
    "for _p in percentages:\n",
    "    if pd.isna(_p) or (isinstance(_p, float) and math.isnan(_p)):\n",
    "        _pct_labels.append(\"0%\")\n",
    "    else:\n",
    "        try:\n",
    "            _pf = float(_p)\n",
    "            if _pf.is_integer():\n",
    "                _pct_labels.append(f\"{int(_pf)}%\")\n",
    "            else:\n",
    "                _pct_labels.append(f\"{_pf}%\")\n",
    "        except Exception:\n",
    "            _pct_labels.append(f\"{_p}%\")\n",
    "\n",
    "for bar, count, pct_label in zip(bars, timing_counts.values, _pct_labels):  # Loop through bars and stats\n",
    "    ax.text(  # Place a label above the bar\n",
    "        bar.get_x() + bar.get_width() / 2,  # Centre the label horizontally on the bar\n",
    "        bar.get_height() + 0.08,  # Position the label slightly above the bar\n",
    "        f\"{int(count)} ({pct_label})\",  # Show count and percentage together\n",
    "        ha=\"center\",  # Centre-align the label\n",
    "        va=\"bottom\",  # Anchor the label from its bottom edge\n",
    "        fontsize=11,  # Keep the label readable\n",
    "        color=\"#4A4A4A\",  # Use neutral dark grey text\n",
    "    )  # End label placement\n",
    "\n",
    "# Set the chart title and axis labels\n",
    "ax.set_title(\"Virality Timing in the Selected Product Sample\", fontsize=14, fontweight=\"bold\", pad=12)  # Title\n",
    "ax.set_xlabel(\"Timing group\", fontsize=11)  # X-axis label\n",
    "ax.set_ylabel(\"Number of products\", fontsize=11)  # Y-axis label\n",
    "\n",
    "# Use whole-number ticks on the y-axis\n",
    "max_count = int(timing_counts.max())  # Find the largest group count as an integer\n",
    "ax.set_yticks(range(0, max_count + 2))  # Set whole-number y-axis ticks with headroom\n",
    "ax.set_ylim(0, max_count + 1.5)  # Extend the y-axis to fit labels above the bars\n",
    "\n",
    "# Remove unnecessary chart borders\n",
    "ax.spines[\"top\"].set_visible(False)  # Hide the top spine\n",
    "ax.spines[\"right\"].set_visible(False)  # Hide the right spine\n",
    "ax.spines[\"left\"].set_color(\"#CCCCCC\")  # Soften the left spine\n",
    "ax.spines[\"bottom\"].set_color(\"#CCCCCC\")  # Soften the bottom spine\n",
    "ax.tick_params(colors=\"#4A4A4A\")  # Ensure tick labels are readable\n",
    "\n",
    "# Add the required figure note below the chart\n",
    "fig.text(  # Add text at figure level so it sits beneath the plot\n",
    "    0.5,  # Centre the note horizontally\n",
    "    0.02,  # Place the note near the bottom of the figure\n",
    "    \"Same-year means no cross-year delay was detectable using year-level viral dates.\",  # Figure note\n",
    "    ha=\"center\",  # Centre-align the note\n",
    "    va=\"bottom\",  # Anchor the note from its bottom edge\n",
    "    fontsize=9,  # Use a smaller font for the note\n",
    "    color=\"#666666\",  # Use a muted grey for the note\n",
    "    style=\"italic\",  # Italicise the figure note\n",
    ")  # End figure note\n",
    "\n",
    "# Adjust layout and leave room for the note\n",
    "plt.tight_layout(rect=[0, 0.06, 1, 1])  # Reserve bottom space for the figure note\n",
    "\n",
    "# Save the chart at high resolution\n",
    "output_dir = Path(\"visualisations\")  # Reference the output folder\n",
    "save_path = output_dir / \"virality_timing_groups.png\"  # Define the output file path\n",
    "fig.savefig(save_path, dpi=300, bbox_inches=\"tight\", facecolor=\"white\")  # Save the PNG at 300 DPI\n",
    "\n",
    "# Display the chart in the notebook\n",
    "plt.show()  # Render the figure\n"
   ]
